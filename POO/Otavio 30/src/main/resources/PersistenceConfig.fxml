<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.view.PersistenceConfigController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Configuração de Armazenamento" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <ComboBox fx:id="comboPersistenceType" prefWidth="200.0" promptText="Selecione o formato..."/>

    <Button text="Salvar Configuração" onAction="#handleSaveConfig" style="-fx-base: #4CAF50; -fx-text-fill: white;"/>
</VBox>